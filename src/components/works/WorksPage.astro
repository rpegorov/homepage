---
/* Project list: employer work first, own products below the divider. */
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n';
import { localePath, type Lang } from '../../lib/lang';
import { groupedWorksOf, workPath, WORK_GROUPS } from '../../lib/works';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const grouped = await groupedWorksOf(lang);
const groups = WORK_GROUPS.map((group) => grouped[group]).filter((works) => works.length > 0);
---
<Base
  lang={lang}
  title={`${t(lang, 'seo.worksTitle')} — Rostislav Egorov (craftzman)`}
  description={t(lang, 'seo.worksDescription')}
  canonicalPath={localePath('/works', lang)}
>
  <h1 class="list-title">{t(lang, 'works.heading')}</h1>
  {groups.map((works, i) => (
    <>
      {i > 0 && <hr class="divider" />}
      <div class="grid">
        {works.map((work) => (
          <a class="card" href={workPath(lang, work.data.slug)}>
            <Image class="card__thumb" src={work.data.thumbnail} alt="" widths={[360, 720]} sizes="(max-width: 640px) 100vw, 336px" />
            <span class="card__title">{work.data.title}</span>
            <span class="card__text">{work.data.description}</span>
          </a>
        ))}
      </div>
    </>
  ))}
</Base>
