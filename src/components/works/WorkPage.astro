---
/* Project page: "Works › Name" with the years badge, the metadata rows, then the note body. */
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n';
import { localePath } from '../../lib/lang';
import { alternatesOf, isIndie, linkOf, workPath, type Work } from '../../lib/works';

interface Props {
  work: Work;
  twin?: Work | undefined;
}
const { work, twin } = Astro.props;
const { lang, slug, title, description, years, stack, platform, thumbnail, machineTranslated } = work.data;
const { Content } = await render(work);
const link = linkOf(work);
const linkLabelKey = { website: 'website', more: 'moreInfo' } as const;
---
<Base
  lang={lang}
  title={`${title} — Rostislav Egorov (craftzman)`}
  description={description}
  canonicalPath={workPath(lang, slug)}
  alternates={alternatesOf(work, twin)}
  ogImage={thumbnail.src}
>
  <div class="crumbs">
    <a href={localePath('/works', lang)}>{t(lang, 'common.nav.works')}</a>
    <span class="crumbs__sep" aria-hidden="true">›</span>
    <h1 class="crumbs__title">{title}</h1>
    <span class="badge">{years}</span>
  </div>

  <ul class="meta-list">
    {platform && (
      <li>
        <span class="badge badge--accent">{t(lang, 'common.meta.platform')}</span>
        <span>{platform}</span>
      </li>
    )}
    {stack && (
      <li>
        <span class="badge badge--accent">{t(lang, 'common.meta.stack')}</span>
        <span>{stack}</span>
      </li>
    )}
    {isIndie(work) && (
      <li>
        <span class="badge badge--accent">{t(lang, 'common.meta.type')}</span>
        <span>{t(lang, 'common.meta.indiePersonal')}</span>
      </li>
    )}
    {link && (
      <li>
        <span class="badge badge--accent">{t(lang, `common.meta.${linkLabelKey[link.kind]}`)}</span>
        <a href={link.href} rel="noopener" target="_blank">{link.label} ↗</a>
      </li>
    )}
  </ul>

  {machineTranslated && (
    <p class="notice" role="note">
      {t(lang, 'blog.machineTranslated')}
      {twin && <> <a href={workPath(twin.data.lang, twin.data.slug)} hreflang={twin.data.lang}>{t(lang, 'blog.readOriginal')}</a></>}
    </p>
  )}

  <div class="prose">
    <Content />
  </div>
</Base>
