---
/* Шапка: стеклянная навигация 56px (компонент Nav брендбука) — lockup слева,
   разделы, тема и язык справа. На мобильном разделы сворачиваются в кнопку
   (src/scripts/site.ts). */
import { t } from '../i18n';
import { localePath, stripLang, type Lang } from '../lib/lang';
import { ICONS } from '../lib/icons';

interface Props {
  lang: Lang;
  /** Путь текущей страницы — для подсветки раздела. */
  path: string;
  /** Страница на каждом языке, где она есть (см. Base `alternates`). */
  alternates: Partial<Record<Lang, string>>;
}
const { lang, path, alternates } = Astro.props;
const section = stripLang(path);
const links = [
  { href: localePath('/works', lang), label: t(lang, 'common.nav.works'), active: section === '/works' || section.startsWith('/works/') },
  { href: localePath('/blog', lang), label: t(lang, 'common.nav.blog'), active: section === '/blog' || section.startsWith('/blog/') },
];
const langs: Array<{ code: Lang; label: string }> = [
  { code: 'en', label: 'EN' },
  { code: 'ru', label: 'RU' },
];
---
<header class="nav">
  <nav class="nav__inner" aria-label={lang === 'ru' ? 'Основное меню' : 'Main'}>
    <a class="nav__logo" href={localePath('/', lang)} aria-label="craftzman">
      <img class="nav__lockup nav__lockup--paper" src="/brand/cz-lockup.svg" alt="craftzman" width="143" height="24" />
      <img class="nav__lockup nav__lockup--sumi" src="/brand/cz-lockup-dark.svg" alt="" width="143" height="24" />
    </a>
    <button class="nav__toggle icon-btn" type="button" aria-expanded="false" aria-controls="nav-links" aria-label={t(lang, 'common.nav.optionsAria')} hidden>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
    <div class="nav__links" id="nav-links">
      {links.map(({ href, label, active }) => (
        <a class:list={['nav__link', { 'nav__link--active': active }]} href={href} aria-current={active ? 'page' : undefined}>{label}</a>
      ))}
      <a class="nav__link" href="https://github.com/rpegorov" rel="noopener" target="_blank">
        <span class="nav__icon" set:html={ICONS.github} />{t(lang, 'common.nav.source')}
      </a>
    </div>
    <div class="nav__actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label={t(lang, 'common.themeToggle.ariaLabel')}>
        <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="currentColor" /></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor" /><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
      <div class="lang" role="group" aria-label={lang === 'ru' ? 'Язык' : 'Language'}>
        {langs.map(({ code, label }) => (
          <a
            class:list={['lang__btn', { 'lang__btn--active': code === lang }]}
            href={alternates[code] ?? localePath('/blog', code)}
            hreflang={code}
            lang={code}
            data-lang={code}
            aria-current={code === lang ? 'true' : undefined}
          >{label}</a>
        ))}
      </div>
    </div>
  </nav>
</header>
