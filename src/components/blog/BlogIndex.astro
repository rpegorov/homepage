---
/* Список постов одного языка: /blog и /ru/blog. */
import Base from '../../layouts/Base.astro';
import PostMeta from './PostMeta.astro';
import { t } from '../../i18n';
import { localePath, type Lang } from '../../lib/lang';
import { postPath, postsOf } from '../../lib/posts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const posts = await postsOf(lang);
---
<Base
  lang={lang}
  title={`${t(lang, 'blog.title')} — Rostislav Egorov (craftzman)`}
  description={t(lang, 'blog.description')}
  canonicalPath={localePath('/blog', lang)}
>
  <h1 class="page-title">{t(lang, 'blog.title')}</h1>
  <p class="lead">{t(lang, 'blog.description')}</p>

  {posts.length === 0 && <p class="lead">{t(lang, 'blog.empty')}</p>}

  <div class="post-list">
    {posts.map((post) => (
      <a class="card" href={postPath(lang, post.data.slug)}>
        <PostMeta lang={lang} date={post.data.date} tags={post.data.tags} />
        <span class="card__title" style="font-family: var(--font-display); font-size: 24px; margin-top: var(--space-2)">{post.data.title}</span>
        <span class="card__text">{post.data.description}</span>
      </a>
    ))}
  </div>

  <p class="back"><a class="label" href={localePath('/rss.xml', lang)}>{t(lang, 'blog.rss')}</a></p>
</Base>
