---
/* Пост: назад к списку, заголовок, дата и теги, плашка машинного перевода,
   обложка и текст в колонке для чтения. hreflang — только существующие версии. */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostMeta from './PostMeta.astro';
import { t } from '../../i18n';
import { localePath } from '../../lib/lang';
import { alternatesOf, formatDay, postPath, type Post } from '../../lib/posts';

interface Props {
  post: Post;
  twin?: Post | undefined;
}
const { post, twin } = Astro.props;
const { lang, slug, title, description, date, updated, tags, cover, machineTranslated } = post.data;
const { Content } = await render(post);
const site = Astro.site!;
const ogImage = `/og/${lang}/${slug}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date,
  dateModified: updated,
  inLanguage: lang,
  image: new URL(ogImage, site).href,
  author: { '@type': 'Person', name: 'Rostislav Egorov', url: `${site.origin}/` },
};
---
<Base
  lang={lang}
  title={`${title} — craftzman`}
  description={description}
  canonicalPath={postPath(lang, slug)}
  alternates={alternatesOf(post, twin)}
  ogImage={ogImage}
  ogType="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={date} />
    <meta property="article:modified_time" content={updated} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article>
    <p class="post-back"><a href={localePath('/blog', lang)}>← {t(lang, 'blog.title')}</a></p>
    <h1 class="post-title">{title}</h1>
    <PostMeta lang={lang} date={date} tags={tags} />
    {updated > date && <p class="post-meta">{t(lang, 'blog.updated', { date: formatDay(updated, lang) })}</p>}

    {machineTranslated && (
      <p class="notice" role="note">
        {t(lang, 'blog.machineTranslated')}
        {twin && <> <a href={postPath(twin.data.lang, twin.data.slug)} hreflang={twin.data.lang}>{t(lang, 'blog.readOriginal')}</a></>}
      </p>
    )}

    {cover && <Image class="post-cover" src={cover} alt="" loading="eager" widths={[736, 1472]} sizes="(max-width: 768px) 100vw, 736px" />}

    <div class="prose">
      <Content />
    </div>

    {twin && !machineTranslated && !twin.data.machineTranslated && (
      <p class="back"><a href={postPath(twin.data.lang, twin.data.slug)} hreflang={twin.data.lang}>{t(lang, 'blog.otherLanguage')}</a></p>
    )}
    <p class="back"><a href={localePath('/blog', lang)}>← {t(lang, 'blog.back')}</a></p>
  </article>
</Base>
