---
import WorkPage from '../../../components/works/WorkPage.astro';
import { twinOf, worksOf, type Work } from '../../../lib/works';

export async function getStaticPaths() {
  const works = await worksOf('ru');
  return Promise.all(works.map(async (work) => ({ params: { slug: work.data.slug }, props: { work, twin: await twinOf(work) } })));
}
const { work, twin } = Astro.props as { work: Work; twin?: Work };
---
<WorkPage work={work} twin={twin} />
